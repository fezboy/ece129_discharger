	(text "Amplification, Bias and Gain Calculations:\nhttps://www.desmos.com/calculator/3htui5wwul\n\nAmplification / Bias Correction Stage:\nVout ~= (Vin*1.0065) + 2.366\n\nVin(min): 2.5V -> Vout(min): 0.15V\nVin(max): 3.175V -> Vout(max): 0.829V"
		(exclude_from_sim no)
		(at 225.806 164.084 0)
		(effects
