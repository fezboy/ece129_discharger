	)
	(text "In-Amp Stage:\nG = 1 * ((49.4*10^3)/Rg)\nG = 1 * ((40.4*10^3)/549) = 89.98~\n\nVout = (Vin * Gain (89.98)) + Vref(2.5V)\n\nVin(min): 0V -> Vout(min): 2.5V\nVin(max): 0.0075V -> Vout(max): 3.175V\n"
		(exclude_from_sim no)
		(at 352.552 151.13 0)
